[Unit]
Description=Rebuild SOCKS5/SOCKS5H privacy proxy pool
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=simple
WorkingDirectory=/home/simple/proxy-pool-jhao104
EnvironmentFile=-/etc/default/proxy-pool-jhao104-privacy
ExecStart=/home/simple/proxy-pool-jhao104/run_privacy_check.sh
Nice=10
PrivateTmp=true

[Install]
WantedBy=multi-user.target
